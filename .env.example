# -----------------------------------------------------------------------------
# Provena configuration
#
# Copy to .env at the repository root:  cp .env.example .env
# Verify everything:                    cd backend && uv run python -m provena.core.config
# -----------------------------------------------------------------------------

# --- Database ----------------------------------------------------------------
# Supabase Postgres. DIRECT_URL is the one that matters: it must be the SESSION
# pooler (port 5432), not the transaction pooler (6543). The code relies on
# session-scoped state that pgbouncer's transaction pooling does not preserve:
#   - conn.set_session(readonly=True)   in core/db.py
#   - SET statement_timeout             in query/sql_engine.py
#
# GOTCHA: if your password contains @ : / ? # [ ] or %, percent-encode it.
# An unencoded '@' makes every URL parser split at the wrong place and read the
# host as "<passwordfragment>@aws-0-...", which fails as "could not translate
# host name". '@' encodes as %40.
DIRECT_URL=postgresql://postgres.<ref>:<password>@<host>.pooler.supabase.com:5432/postgres

# Optional. The transaction pooler, kept only for tooling that wants it.
# Any ?pgbouncer=true suffix is stripped automatically (libpq rejects it).
DATABASE_URL=

# Requires the pgvector and pg_trgm extensions:
#   CREATE EXTENSION IF NOT EXISTS vector;
#   CREATE EXTENSION IF NOT EXISTS pg_trgm;

# --- Groq (chat / SQL generation) --------------------------------------------
GROQ_API_KEY=gsk_...
# llama-3.1-8b-instant was retired; no Llama model remains on Groq.
# Available: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b,
#            qwen/qwen3.6-27b, groq/compound, groq/compound-mini
GROQ_MODEL=openai/gpt-oss-20b
# Free tier: 1000 requests/day, 8000 tokens/minute (same for every model).
# 429s are waited out using Retry-After, up to this many attempts.
GROQ_MAX_RETRIES=4
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# --- Jina (embeddings) -------------------------------------------------------
JINA_API_KEY=jina_...
JINA_MODEL=jina-embeddings-v3
# Asymmetric retrieval adapters. Changing either invalidates stored vectors.
JINA_QUERY_TASK=retrieval.query
JINA_PASSAGE_TASK=retrieval.passage
JINA_BATCH_SIZE=32
EMBEDDING_DIMENSIONS=1024
# JINA_API_URL=https://api.jina.ai/v1/embeddings

# --- Retrieval ---------------------------------------------------------------
# Hybrid recall (vector + full-text), reciprocal-rank fusion, then a Jina
# cross-encoder rerank using the same JINA_API_KEY. With RERANK_ENABLED=false,
# or if the rerank API fails, the fused order is used as-is.
RERANK_ENABLED=true
RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_URL=https://api.jina.ai/v1/rerank
RETRIEVAL_POOL=40
RRF_K=60
RERANK_CANDIDATES=20
RAG_TOP_K=5
# A sub-question counts as ANSWERED when a source reranks at or above this.
RERANK_ANSWERED_SCORE=0.3

# --- Mistral (OCR) -----------------------------------------------------------
# Note the variable name: MISTRAL_OCR, not MISTRAL_API_KEY.
MISTRAL_OCR=...
MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_OCR_URL=https://api.mistral.ai/v1/ocr

# --- Query engine ------------------------------------------------------------
# "slots"    LLM fills template slots; Python renders parameterised SQL (default)
# "freeform" LLM writes SQL directly, checked by the AST validator
SQL_STRATEGY=slots
SQL_MAX_ROWS=1000
SQL_STATEMENT_TIMEOUT=10s

# --- Runtime -----------------------------------------------------------------
API_PORT=8000
FLASK_DEBUG=false
MAX_UPLOAD_BYTES=52428800
# Wipe all documents, tables, chunks and files after this much idle time.
INACTIVITY_TIMEOUT_SECONDS=7200
MEMORY_MAX_TURNS=6
MEMORY_MAX_CHARS=2000

# --- Storage -----------------------------------------------------------------
# Defaults are <repo>/uploads and <repo>/output.
# UPLOAD_FOLDER=
# OUTPUT_DIR=
# VECTOR_TABLE_NAME=document_chunks

# --- Frontend ----------------------------------------------------------------
# Read by frontend/lib/api.ts. There is no Next.js proxy; the backend sets CORS.
NEXT_PUBLIC_API_URL=http://localhost:8000
